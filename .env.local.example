# ─── EarthOspacE — Environment Variables ────────────────────────────
# Copy this file as .env.local in your project root.
# NEVER commit .env.local to git.

# ── IBM Watsonx.ai (Granite LLM) ─────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_project_id_here

# ── NASA Open Data APIs ────────────────────────────────────────────────────
NASA_API_KEY=your_nasa_api_key_here

# ── OpenWeatherMap ────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── NewsAPI.org ────────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Demo Mode ──────────────────────────────────────────────────────────────
# Set to "true" to use pre-generated mock data (no AI API calls).
# Set to "false" (or remove) to use live IBM Granite + real APIs.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
