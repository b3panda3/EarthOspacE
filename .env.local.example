# ─── EarthOspacE — Environment Variables Example ────────────────────
#
# Copy this file to .env.local and fill in your real credentials.
#   cp .env.local.example .env.local
#
# Set DEMO_MODE=true to use pre-generated mock AI responses without any
# API keys — ideal for local exploration and hackathon judge demos.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo Mode ────────────────────────────────────────────────────────────────
# When true: all IBM Granite AI calls return pre-generated mock responses
# instantly. The prototype always works — no API credits consumed.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ── IBM Watsonx AI (required when DEMO_MODE=false) ───────────────────────────
# 1. Log in at https://cloud.ibm.com
# 2. Open Watsonx.ai → create or select a project
# 3. Generate an IAM API key: Manage → Access → API Keys
# 4. Copy the Project ID from the project settings panel
#
# Instance 2 is optional but recommended — doubles AI throughput (4 req/sec).
NEXT_PUBLIC_WATSONX_API_KEY=your_ibm_cloud_iam_api_key_here
NEXT_PUBLIC_WATSONX_URL=https://eu-de.ml.cloud.ibm.com
NEXT_PUBLIC_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── IBM Watsonx AI Instance 2 (optional, doubles throughput) ─────────────────
WATSONX_API_KEY2=
NEXT_PUBLIC_WATSONX_API_KEY2=
WATSONX_PROJECT_ID2=
NEXT_PUBLIC_WATSONX_PROJECT_ID2=

# ── NASA Open Data API ───────────────────────────────────────────────────────
# Free key at https://api.nasa.gov/
# Use DEMO_KEY for testing (rate-limited to 30 req/hr per IP).
NEXT_PUBLIC_NASA_API_KEY=DEMO_KEY

# ── OpenWeatherMap ───────────────────────────────────────────────────────────
# Free tier at https://openweathermap.org/api (1,000 calls/day)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── NewsAPI ──────────────────────────────────────────────────────────────────
# Free tier at https://newsapi.org/ (100 requests/day)
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key_here

# ── Supabase (optional — features degrade gracefully without these) ──────────
# Create a free project at https://supabase.com
# Used for: telemetry_history snapshots, user profile persistence, bookmarks
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
